# ═══════════════════════════════════════════════════════════
# ALIDSC — Configuration production
# Copier ce fichier en .env sur le serveur, puis remplir
# les valeurs marquées "OBLIGATOIRE".
# ═══════════════════════════════════════════════════════════

APP_NAME=ALIDSC
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alidsc.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── Base de données ───────────────────────────────────────
# Option A — SQLite (simple, aucun serveur à gérer)
#   DB_CONNECTION=sqlite
#   (laisser DB_DATABASE vide, le fichier database/database.sqlite sera utilisé)
#
# Option B — MySQL
#   Remplir les champs ci-dessous.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─── Sessions sécurisées ───────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=alidsc.org
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── File d'attente : synchrone (aucun worker à configurer)
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ─── Mail SMTP ─────────────────────────────────────────────
# Recommandé : Brevo (300 emails/jour gratuits, https://www.brevo.com)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@alidsc.org"
MAIL_FROM_NAME="ALIDSC"

# ─── Compte admin initial ──────────────────────────────────
# Utilisé UNIQUEMENT par `php artisan migrate --seed`.
# À SUPPRIMER DU .env après la première exécution.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Admin ALIDSC"

VITE_APP_NAME="${APP_NAME}"