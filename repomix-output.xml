}
.quote-card__name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--marine);
}
.quote-card__role {
    font-size: 0.8125rem;
    color: var(--text-muted);
}

/* ─────────────────────────────────────────────────────────
   33 · QUARTIERS — ancrage local
   ───────────────────────────────────────────────────────── */
.quartier-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-4);
}
@media (max-width: 1024px) {
    .quartier-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 640px) {
    .quartier-grid { grid-template-columns: repeat(2, 1fr); }
}
.quartier-card {
    padding: var(--sp-5);
