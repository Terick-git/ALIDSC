}
.quartier-card__desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0;
}

/* ─────────────────────────────────────────────────────────
   34 · PARTENAIRES — bandeau logos
   ───────────────────────────────────────────────────────── */
.partner-row {
    display: flex;
