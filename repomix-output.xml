<file path="app/Http/Controllers/AdhesionController.php">
<?php

namespace App\Http\Controllers;

use App\Models\Adherent;
use App\Models\User;
use App\Notifications\NouvelleDemandeAdhesion;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;
use Illuminate\View\View;

class AdhesionController extends Controller
{
    /**
     * Affiche le formulaire d'adhésion (page publique).
     */
    public function index(): View
    {
        return view('pages.adherer');
    }

    /**
     * Enregistre une nouvelle demande d'adhésion.
     *
     * RÈGLE MÉTIER : aucune adhésion n'est finalisée automatiquement.
     * La demande est stockée en « en_attente » et le compte n'est PAS actif.
     * Un admin devra valider manuellement.
     */
    public function store(Request $request): RedirectResponse
    {
        $validated = $request->validate([
            'nom'                 => ['required', 'string', 'max:255'],
            'prenom'              => ['required', 'string', 'max:255'],
            'date_naissance'      => ['required', 'date', 'before:today'],
            'etablissement'       => ['required', 'string', 'max:255'],
            'categorie'           => ['required', 'in:simple,actif'],
            'cotisation_proposee' => ['nullable', 'integer', 'min:0', 'max:1000000'],
            'piece_identite'      => ['required', 'file', 'mimetypes:application/pdf,image/jpeg,image/png', 'max:5120'],
            'email'               => ['required', 'email', 'unique:adherents,email'],
            'telephone'           => ['required', 'string', 'max:30'],
            'adresse'             => ['required', 'string', 'max:255'],
            'ville'               => ['nullable', 'string', 'max:100'],
            'motivation'          => ['nullable', 'string', 'max:2000'],
        ], [
            'email.unique'                => 'Cet email est déjà enregistré. Contactez-nous si besoin.',
            'piece_identite.required'     => 'Veuillez joindre une copie de votre pièce d\'identité.',
            'piece_identite.mimetypes'    => 'Format accepté : PDF, JPG ou PNG.',
            'piece_identite.max'          => 'La pièce d\'identité ne doit pas dépasser 5 Mo.',
            'cotisation_proposee.integer' => 'Le montant doit être un nombre entier.',
            'cotisation_proposee.max'     => 'Le montant proposé dépasse le plafond autorisé.',
        ]);

        try {
            $adherent = DB::transaction(function () use ($validated, $request) {
                // Stockage privé (hors du dossier public)
                $piecePath = $request->file('piece_identite')
                    ->store('pieces-identite', 'private');

                return Adherent::create([
                    'nom'                 => $validated['nom'],
                    'prenom'              => $validated['prenom'],
                    'date_naissance'      => $validated['date_naissance'],
                    'etablissement'       => $validated['etablissement'],
                    'categorie'           => $validated['categorie'],
                    'cotisation_proposee' => $validated['cotisation_proposee'] ?? null,
                    'email'               => $validated['email'],
                    'telephone'           => $validated['telephone'],
                    'adresse'             => $validated['adresse'],
                    'ville'               => $validated['ville'] ?? null,
                    'piece_identite'      => $piecePath,
                    'notes'               => $validated['motivation'] ?? null,
                    'date_adhesion'       => now(),
                    'cotisation_montant'  => 0,
                    'statut_cotisation'   => 'en_attente',
                    'statut_demande'      => 'en_attente',
                    'actif'               => false,
                    'espace_actif'        => false,
                ]);
            });
        } catch (\Throwable $e) {
            Log::error('Création adhérent échouée', [
                'file'      => $e->getFile(),
                'line'      => $e->getLine(),
                'exception' => $e->getMessage(),
            ]);

            return back()->withInput()
                ->withErrors([
                    'email' => 'Une erreur est survenue. Merci de réessayer ou de nous contacter.',
                ]);
        }

        // Notifier tous les administrateurs
        $admins = User::where('role', 'admin')->get();

        foreach ($admins as $admin) {
            try {
                $admin->notify(new NouvelleDemandeAdhesion($adherent));
            } catch (\Throwable $e) {
                Log::error('Notification admin échouée', [
                    'admin_id'    => $admin->id,
                    'adherent_id' => $adherent->id,
                    'exception'   => $e->getMessage(),
                ]);
            }
        }

        return redirect()
            ->route('adherer')
            ->with('success', 'Votre demande a bien été envoyée. Un responsable ALIDSC va l\'examiner et vous contactera par email.');
    }
}
</file>

<file path="resources/css/alidsc.css">
/* ═══════════════════════════════════════════════════════════
   ALIDSC — Design System v4.0
   Éditorial · Moderne · Minimal
   Bleu #0B6FB8 · Vert #1F7A50 · Marine #10263B
   Bricolage Grotesque · Source Sans 3
   ═══════════════════════════════════════════════════════════ */

/* ─────────────────────────────────────────────────────────
   01 · TOKENS
   ───────────────────────────────────────────────────────── */
:root {
    /* Couleurs */
    --blue:         #0B6FB8;
    --blue-hover:   #0A5E9C;
    --blue-light:   #E6F0F9;

    --green:        #1F7A50;
    --green-hover:  #196340;
    --green-light:  #E6F2EC;

    --marine:       #10263B;
    --marine-deep:  #0A1B2A;

    --text:         #22384D;
    --text-muted:   #6B7E92;
    --text-soft:    #8A9AAC;

    --paper:        #FFFFFF;
    --paper-tint:   #EEF5FB;

    --line:         #CFDCE8;
    --line-soft:    #E4ECF3;

    /* Typographie */
    --display: 'Bricolage Grotesque', system-ui, sans-serif;
    --body:    'Source Sans 3', system-ui, sans-serif;
    --mono:    ui-monospace, 'SF Mono', Menlo, monospace;

    /* Espacement — échelle 8pt */
    --sp-1:  0.25rem;
    --sp-2:  0.5rem;
    --sp-3:  0.75rem;
    --sp-4:  1rem;
    --sp-5:  1.5rem;
    --sp-6:  2rem;
    --sp-7:  3rem;
    --sp-8:  4rem;
    --sp-9:  6rem;
    --sp-10: 8rem;
    --sp-11: 12rem;

    /* Rythme vertical de section */
    --sec-s: var(--sp-8);   /*  64px */
    --sec-m: var(--sp-9);   /*  96px */
    --sec-l: var(--sp-10);  /* 128px */

    /* Rayon */
    --radius: 4px;

    /* Transitions — uniquement sur les propriétés concernées */
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --dur:  200ms;

    /* Layout */
    --header-h: 72px;
    --frame:    1100px;
    --frame-narrow: 720px;
    --frame-tight:  900px;
}

/* ─────────────────────────────────────────────────────────
   02 · RESET
   ───────────────────────────────────────────────────────── */
*,
*::before,
*::after { box-sizing: border-box; }

html,
body { margin: 0; padding: 0; }

html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    scroll-padding-top: calc(var(--header-h) + 1rem);
}

img, picture, video, svg {
    max-width: 100%;
    height: auto;
    display: block;
}

ul, ol { margin: 0; padding: 0; list-style: none; }

button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
}

input, textarea, select { font: inherit; color: inherit; }

/* ─────────────────────────────────────────────────────────
   03 · BASE
   ───────────────────────────────────────────────────────── */
body {
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.6;
    font-weight: 400;
    color: var(--text);
    background: var(--paper);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
    font-feature-settings: "kern", "liga", "ss01";
}

::selection {
    background: var(--marine);
    color: var(--paper);
}

:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
}

a {
    color: var(--blue);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
}
a:hover { color: var(--blue-hover); }

/* ─────────────────────────────────────────────────────────
   04 · LAYOUT — 3 largeurs canoniques
   ───────────────────────────────────────────────────────── */
.frame,
.frame-tight,
.frame-narrow {
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--sp-6);
}
.frame        { max-width: var(--frame); }
.frame-tight  { max-width: var(--frame-tight); }
.frame-narrow { max-width: var(--frame-narrow); }

@media (max-width: 640px) {
    .frame,
    .frame-tight,
    .frame-narrow { padding: 0 var(--sp-4); }
}

/* ─────────────────────────────────────────────────────────
   05 · TYPOGRAPHIE
   ───────────────────────────────────────────────────────── */
.display-1,
.display-2,
.display-3,
h1, h2, h3, h4 {
    font-family: var(--display);
    font-weight: 800;
    color: var(--marine);
    margin: 0;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
}

.display-1 {
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
}

.display-2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.02;
}

.display-3 {
    font-size: clamp(1.375rem, 2.8vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
}

.display-1 em,
.display-2 em,
.display-3 em {
    font-style: italic;
    font-weight: 400;
    color: var(--blue);
}

.para,
.para-lg,
p {
    color: var(--text);
    text-wrap: pretty;
}

.para    { font-size: 1.0625rem; line-height: 1.65; }
.para-lg { font-size: 1.1875rem; line-height: 1.6; }

.meta {
    display: block;
    font-family: var(--body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
}

/* ─────────────────────────────────────────────────────────
   06 · FILETS ET ORNEMENTS
   ───────────────────────────────────────────────────────── */
.rule {
    width: 100%;
    height: 1px;
    background: var(--line);
    border: 0;
    margin: 0;
}

.divider {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-8) 0;
}
.divider__line {
    flex: 1;
    height: 1px;
    background: var(--line);
}
.divider__mark {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
}
.divider__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--blue);
}
.divider__dot--sm {
    width: 2px;
    height: 2px;
    background: var(--line);
}

/* ─────────────────────────────────────────────────────────
   07 · BOUTONS ET LIENS D'ACTION
   ───────────────────────────────────────────────────────── */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    font-family: var(--body);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    border: 1.5px solid transparent;
    border-radius: var(--radius);
    white-space: nowrap;
    transition: background var(--dur) var(--ease),
                color      var(--dur) var(--ease),
                border-color var(--dur) var(--ease);
}
.btn svg {
    flex-shrink: 0;
    transition: transform var(--dur) var(--ease);
}
.btn:hover svg { transform: translateX(3px); }

.btn-primary {
    background: var(--blue);
    color: var(--paper);
}
.btn-primary:hover {
    background: var(--blue-hover);
    color: var(--paper);
}

.btn-green {
    background: var(--green);
    color: var(--paper);
}
.btn-green:hover {
    background: var(--green-hover);
    color: var(--paper);
}

.btn-outline {
    background: transparent;
    color: var(--marine);
    border-color: var(--marine);
}
.btn-outline:hover {
    background: var(--marine);
    color: var(--paper);
}

.link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--blue);
    padding-bottom: 0.375rem;
    border-bottom: 1px solid currentColor;
    transition: gap var(--dur) var(--ease),
                color var(--dur) var(--ease);
}
.link-arrow:hover {
    gap: 0.875rem;
    color: var(--blue-hover);
}
.link-arrow svg { width: 16px; height: 16px; }

/* ─────────────────────────────────────────────────────────
   08 · IMAGES
   ───────────────────────────────────────────────────────── */
.img-frame {
    position: relative;
    overflow: hidden;
    background: var(--paper-tint);
    border-radius: var(--radius);
}
.img-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
}
.img-frame--portrait  { aspect-ratio: 4/5; }
.img-frame--landscape { aspect-ratio: 4/3; }
.img-frame--wide      { aspect-ratio: 16/9; }
.img-frame--square    { aspect-ratio: 1/1; }
.img-frame--tall      { aspect-ratio: 3/4; }

.img-frame--hover:hover img { transform: scale(1.03); }

/* ─────────────────────────────────────────────────────────
   09 · HEADER
   ───────────────────────────────────────────────────────── */
.top {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: 0 var(--sp-6);
    height: var(--header-h);
    background: var(--paper);
    border-bottom: 1px solid var(--line);
}

.top-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--marine);
    flex-shrink: 0;
}
.top-brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: contain;
    flex-shrink: 0;
}

.top-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0 auto;
}
.top-nav a {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    padding: 0.25rem 0;
}
.top-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--marine);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease);
}
.top-nav a:hover::after,
.top-nav a[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
}
.top-nav a:hover,
.top-nav a[aria-current="page"] { color: var(--marine); }

.top-nav-secondary {
    color: var(--text-muted) !important;
    padding-left: 1.5rem !important;
    border-left: 1px solid var(--line);
    margin-left: 0.5rem;
}
.top-nav-secondary::after { display: none !important; }

.top-cta-don {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    background: var(--green);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: var(--radius);
    flex-shrink: 0;
    transition: background var(--dur) var(--ease);
}
.top-cta-don:hover {
    background: var(--green-hover);
    color: var(--paper);
}

.top-mobile-toggle {
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    color: var(--marine);
    flex-shrink: 0;
}
.top-mobile-toggle span,
.top-mobile-toggle span::before,
.top-mobile-toggle span::after {
    display: block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur) var(--ease);
}
.top-mobile-toggle span { position: relative; }
.top-mobile-toggle span::before,
.top-mobile-toggle span::after {
    content: '';
    position: absolute;
    left: 0;
}
.top-mobile-toggle span::before { top: -6px; }
.top-mobile-toggle span::after  { top: 6px; }
.top-mobile-toggle.active span { background: transparent; }
.top-mobile-toggle.active span::before { top: 0; transform: rotate(45deg); }
.top-mobile-toggle.active span::after  { top: 0; transform: rotate(-45deg); }

@media (max-width: 1024px) {
    .top { padding: 0 var(--sp-4); }
    .top-nav { display: none; }
    .top-cta-don { display: none; }
    .top-mobile-toggle { display: inline-flex; }
}

/* ─────────────────────────────────────────────────────────
   10 · MENU MOBILE
   ───────────────────────────────────────────────────────── */
.mobile-panel {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 99;
    padding: var(--sp-6) var(--sp-4);
    background: var(--paper);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity var(--dur) var(--ease),
                transform var(--dur) var(--ease),
                visibility var(--dur) var(--ease);
}
.mobile-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}
.mobile-panel nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
}
.mobile-panel nav a {
    display: block;
    padding: 1.125rem 0;
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--marine);
    border-bottom: 1px solid var(--line);
}
.mobile-panel nav a:hover { color: var(--blue); }
.mobile-panel-cta {
    display: inline-flex;
    margin-top: var(--sp-6);
    padding: 0.875rem 1.5rem;
    background: var(--green);
    color: var(--paper);
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: var(--radius);
}

/* ─────────────────────────────────────────────────────────
   11 · SECTIONS — rythme vertical
   ───────────────────────────────────────────────────────── */
.section,
.section--m   { padding: var(--sec-m) 0; }
.section--s   { padding: var(--sec-s) 0; }
.section--l   { padding: var(--sec-l) 0; }
.section--tint    { background: var(--paper-tint); }
.section--paper   { background: var(--paper); }
.section--marine  { background: var(--marine); color: var(--paper); }
.section--marine h1,
.section--marine h2,
.section--marine h3,
.section--marine .display-1,
.section--marine .display-2,
.section--marine .display-3 { color: var(--paper); }
.section--marine .para,
.section--marine .para-lg { color: rgba(255, 255, 255, 0.75); }

/* En-tête de section canonique */
.section-head {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
    padding-bottom: var(--sp-6);
    margin-bottom: var(--sp-8);
    border-bottom: 1px solid var(--line);
    max-width: 780px;
}
.section-head .meta { color: var(--blue); }
.section-head__title {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--marine);
    text-wrap: balance;
}
.section-head__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--blue);
}

/* ─────────────────────────────────────────────────────────
   12 · MASTHEAD — hero typographique
   ───────────────────────────────────────────────────────── */
.masthead {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--sp-8);
    padding: var(--sp-7) var(--sp-6) var(--sp-6);
    min-height: calc(100vh - var(--header-h));
    background: var(--paper);
    border-bottom: 1px solid var(--line);
}

/* ─── Colonne principale ────────────────────────────── */
.masthead__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-8);
    min-width: 0;
}

.masthead__rail {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    flex-wrap: wrap;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
}

/* ─── Le titre massif ──────────────────────────────── */
.masthead__title {
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: center;
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.75rem, 10vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
    color: var(--marine);
    text-wrap: nowrap;
}
.masthead__line {
    display: block;
}
.masthead__line:nth-child(2) { padding-left: 0.4em; }
.masthead__line:nth-child(3) { padding-left: 0.8em; }
.masthead__line--accent {
    font-style: italic;
    font-weight: 400;
    color: var(--blue);
}

/* ─── Pied du hero ─────────────────────────────────── */
.masthead__foot {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-8);
    align-items: end;
    padding-top: var(--sp-6);
    border-top: 1px solid var(--line);
}
.masthead__lede {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--text);
    max-width: 480px;
    margin: 0;
}
.masthead__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    flex-wrap: wrap;
}
.masthead__ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--marine);
    border-bottom: 1.5px solid var(--line);
    transition: border-color var(--dur) var(--ease),
                color        var(--dur) var(--ease);
}
.masthead__ghost:hover {
    color: var(--blue);
    border-color: var(--blue);
}

/* ─── Bande verticale (image) ──────────────────────── */
.masthead__figure {
    position: relative;
    overflow: hidden;
    background: var(--paper-tint);
}
.masthead__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* ─── Responsive ───────────────────────────────────── */
@media (max-width: 1280px) {
    .masthead {
        grid-template-columns: 1fr 260px;
        gap: var(--sp-7);
    }
}

@media (max-width: 1024px) {
    .masthead {
        grid-template-columns: 1fr 220px;
        gap: var(--sp-6);
    }
}

@media (max-width: 900px) {
    .masthead {
        grid-template-columns: 1fr;
        gap: var(--sp-6);
        min-height: auto;
        padding: var(--sp-6) var(--sp-4) var(--sp-7);
    }
    .masthead__content { gap: var(--sp-7); }
    .masthead__title {
        font-size: clamp(2.5rem, 12vw, 4.5rem);
        text-wrap: normal;
    }
    .masthead__foot {
        grid-template-columns: 1fr;
        gap: var(--sp-5);
        padding-top: var(--sp-5);
    }
    .masthead__figure {
        aspect-ratio: 16/10;
        margin-top: var(--sp-5);
    }
}

@media (max-width: 520px) {
    .masthead__rail {
        font-size: 0.625rem;
        letter-spacing: 0.16em;
    }
    .masthead__line:nth-child(2) { padding-left: 0.3em; }
    .masthead__line:nth-child(3) { padding-left: 0.6em; }
}

/* ─────────────────────────────────────────────────────────
   13 · MANIFESTE — déclaration
   ───────────────────────────────────────────────────────── */
.statement {
    padding: var(--sec-l) 0;
    background: var(--paper);
}
.statement__quote {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.2vw, 2.375rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--marine);
    max-width: 820px;
    margin: 0;
    text-wrap: balance;
}
.statement__quote em {
    font-style: italic;
    color: var(--blue);
}

/* ─────────────────────────────────────────────────────────
   14 · CHIFFRES — ledger
   ───────────────────────────────────────────────────────── */
.ledger {
    padding: var(--sec-m) 0 var(--sec-l);
    background: var(--paper);
}
.ledger .frame { border-top: 1px solid var(--line); }

.number-row {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--sp-9);
    padding: var(--sp-7) 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
}
@media (max-width: 768px) {
    .number-row {
        grid-template-columns: 1fr;
        gap: var(--sp-3);
        padding: var(--sp-6) 0;
    }
}

.number-value {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(2.75rem, 5.5vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--marine);
    font-variant-numeric: tabular-nums;
}
.number-value .plus {
    font-size: 0.5em;
    font-weight: 600;
    color: var(--blue);
}
.number-value .unit {
    font-size: 0.28em;
    font-weight: 600;
    color: var(--blue);
    letter-spacing: 0;
    align-self: flex-end;
    padding-bottom: 0.4em;
}

.number-detail h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--marine);
    margin: 0 0 0.5rem;
}
.number-detail p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
    max-width: 560px;
}

/* ─────────────────────────────────────────────────────────
   15 · AXES — liste numérotée
   ───────────────────────────────────────────────────────── */
.axes-list {
    border-top: 1px solid var(--line);
}
.axe {
    display: grid;
    grid-template-columns: 80px 1fr 1.6fr;
    gap: var(--sp-7);
    padding: var(--sp-7) 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
}
@media (max-width: 768px) {
    .axe {
        grid-template-columns: 1fr;
        gap: 0.75rem;
        padding: var(--sp-6) 0;
    }
}
.axe-num {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
}
.axe-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--marine);
    margin: 0;
}
.axe-desc {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
    max-width: 620px;
}

/* ─────────────────────────────────────────────────────────
   16 · ENTRIES — articles, événements
   ───────────────────────────────────────────────────────── */
.entry-list {
    border-top: 1px solid var(--line);
}
.entry {
    display: grid;
    grid-template-columns: 120px 1fr 240px;
    gap: var(--sp-7);
    padding: var(--sp-7) 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
    color: inherit;
    transition: opacity var(--dur) var(--ease);
}
@media (max-width: 768px) {
    .entry {
        grid-template-columns: 1fr;
        gap: var(--sp-4);
        padding: var(--sp-6) 0;
    }
}
.entry-date {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-top: 0.25rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
}
.entry-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--marine);
    margin: 0 0 0.75rem;
    transition: color var(--dur) var(--ease);
}
.entry-excerpt {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 620px;
    margin: 0;
}
.entry-image {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--paper-tint);
    border-radius: var(--radius);
}
.entry-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
}
.entry:hover .entry-title { color: var(--blue); }
.entry:hover .entry-image img { transform: scale(1.03); }
@media (max-width: 768px) {
    .entry-image { max-width: 240px; }
}

/* ─────────────────────────────────────────────────────────
   17 · PORTRAIT — citation + photo
   ───────────────────────────────────────────────────────── */
.portrait-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--sp-9);
    align-items: center;
}
@media (max-width: 1024px) {
    .portrait-grid {
        grid-template-columns: 1fr;
        gap: var(--sp-7);
    }
}
.portrait-photo {
    aspect-ratio: 4/5;
    overflow: hidden;
    background: var(--paper-tint);
    border-radius: var(--radius);
}
.portrait-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
@media (max-width: 1024px) {
    .portrait-photo { max-width: 420px; }
}

.portrait-quote {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.375rem, 2.8vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: var(--marine);
    margin: 0 0 var(--sp-6);
    text-wrap: balance;
}
.portrait-quote em {
    font-style: italic;
    color: var(--blue);
}
.portrait-attr {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
}
.portrait-name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--marine);
}
.portrait-role {
    font-size: 0.875rem;
    color: var(--text-muted);
}

/* ─────────────────────────────────────────────────────────
   18 · ADHÉSION — 2 options
   ───────────────────────────────────────────────────────── */
.adhesion-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-8);
    border-top: 1px solid var(--line);
    padding-top: var(--sp-8);
}
@media (max-width: 768px) {
    .adhesion-grid {
        grid-template-columns: 1fr;
        gap: var(--sp-7);
    }
}
.adhesion-option {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
}
.adhesion-option__num {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    color: var(--blue);
}
.adhesion-option__title {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--marine);
    margin: 0;
}
.adhesion-option__text {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
}

/* ─────────────────────────────────────────────────────────
   19 · DON BANNER
   ───────────────────────────────────────────────────────── */
.don-banner {
    padding: var(--sec-l) 0;
    background: var(--marine);
    color: var(--paper);
    text-align: left;
}
.don-banner h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.875rem, 4.5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--paper);
