    letter-spacing: -0.02em;
    color: var(--marine);
    margin: 0 0 0.5rem;
}
.placeholder-card p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
}

/* ─────────────────────────────────────────────────────────
   32 · QUOTE GRID — témoignages
   ───────────────────────────────────────────────────────── */
.quote-grid {
    display: grid;
